{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    // The examples consume the published declarations. The old packages were
    // installed under node_modules; in the engine they are subpaths of one
    // package, so each subpath is named here at its dist declaration, and the
    // judgment package the engine depends on at its built declarations.
    "paths": {
      "@goodvibes-jev/engine/package.json": [
        "../package.json"
      ],
      "@goodvibes-jev/judgment": [
        "../../judgment/dist/index.d.ts"
      ],
      "@goodvibes-jev/judgment/*": [
        "../../judgment/dist/*.d.ts",
        "../../judgment/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/platform/browser/agent": [
        "../platform/dist/browser-agent.d.ts"
      ],
      "@goodvibes-jev/engine/platform/browser/homeassistant": [
        "../platform/dist/browser-homeassistant.d.ts"
      ],
      "@goodvibes-jev/engine/platform/browser/knowledge": [
        "../platform/dist/browser-knowledge.d.ts"
      ],
      "@goodvibes-jev/engine/platform/contracts/node": [
        "../platform/dist/contracts-node.d.ts"
      ],
      "@goodvibes-jev/engine/platform/platform/runtime/fleet/observed": [
        "../platform/dist/platform/runtime/fleet/observed/source.d.ts"
      ],
      "@goodvibes-jev/engine/platform/sql-js": [
        "../platform/dist/platform/types/sql-js.d.ts"
      ],
      "@goodvibes-jev/engine/contracts": [
        "../contracts/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/contracts/*": [
        "../contracts/dist/*.d.ts",
        "../contracts/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/daemon-api": [
        "../daemon-api/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/daemon-api/*": [
        "../daemon-api/dist/*.d.ts",
        "../daemon-api/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/errors": [
        "../errors/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/errors/*": [
        "../errors/dist/*.d.ts",
        "../errors/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/operator-client": [
        "../operator-client/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/operator-client/*": [
        "../operator-client/dist/*.d.ts",
        "../operator-client/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/peer-client": [
        "../peer-client/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/peer-client/*": [
        "../peer-client/dist/*.d.ts",
        "../peer-client/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/platform": [
        "../platform/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/platform/*": [
        "../platform/dist/*.d.ts",
        "../platform/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/terminal-shell": [
        "../terminal-shell/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/terminal-shell/*": [
        "../terminal-shell/dist/*.d.ts",
        "../terminal-shell/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/toolchain": [
        "../toolchain/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/toolchain/*": [
        "../toolchain/dist/*.d.ts",
        "../toolchain/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-core": [
        "../transport-core/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-core/*": [
        "../transport-core/dist/*.d.ts",
        "../transport-core/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-http": [
        "../transport-http/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-http/*": [
        "../transport-http/dist/*.d.ts",
        "../transport-http/dist/*/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-realtime": [
        "../transport-realtime/dist/index.d.ts"
      ],
      "@goodvibes-jev/engine/transport-realtime/*": [
        "../transport-realtime/dist/*.d.ts",
        "../transport-realtime/dist/*/index.d.ts"
      ]
    }
  },
  "include": [
    // Examples intentionally cover JavaScript, TypeScript, and ESM entry
    // points only; native mobile snippets live in docs, not this typecheck.
    "*.mjs",
    "*.ts",
    "*.tsx"
  ]
}
