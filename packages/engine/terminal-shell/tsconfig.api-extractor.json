{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  // api-extractor runs its own tsc pass. Without this file that pass inherits
  // the package's composite build settings and writes into dist/, stomping the
  // real build output, the same reason packages/engine/platform carries one. See
  // scripts/api-extractor.SETUP.md.
  "references": []
}
