{
  "extends": "../../products/agent/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "../../products/agent/src/*"
      ]
    }
  },
  "include": [
    "test/agent-research-screening-composition.test.ts",
    "test/daemon-native-ci-continuation.test.ts",
    "test/workspace-version.test.ts",
    "platform/src/platform/types/*.d.ts"
  ],
  "exclude": [],
  // Engine imports resolve to source through the bun condition; with these
  // references they read the engine projects' declarations instead, so the
  // engine is checked once (by its own build), not again in this program.
  // References are not inherited through extends.
  "references": [
    { "path": "../judgment" },
    { "path": "./contracts" },
    { "path": "./errors" },
    { "path": "./daemon-api" },
    { "path": "./transport-core" },
    { "path": "./transport-http" },
    { "path": "./transport-realtime" },
    { "path": "./operator-client" },
    { "path": "./peer-client" },
    { "path": "./platform" },
    { "path": "./terminal-shell" },
    { "path": "./toolchain" }
  ]
}
