+// Whether a branch holds a `*` outside brackets, quotes and escapes: a glob
+// star, which compiles to an unbounded quantifier.
+const hasUnboundedStar = branch => {
+  let bracket = 0;
+  let quote = 0;
+  let escaped = false;
+
+  for (const ch of branch) {
+    if (escaped === true) {
+      escaped = false;
+      continue;
+    }
+
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+
+    if (ch === '"') {
+      quote = quote === 1 ? 0 : 1;
+      continue;
+    }
+
+    if (quote === 1) {
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket++;
+      continue;
+    }
+
+    if (ch === ']' && bracket > 0) {
+      bracket--;
+      continue;
+    }
+
+    if (bracket === 0 && ch === '*') {
+      return true;
+    }
+  }
+
+  return false;
+};
